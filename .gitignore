node_modules
.DS_Store

# Env files. `*.env` matched .env but NOT .env.local or .env.production, so
# those were tracked by default.
.env
.env.*
!.env.example

# Build output and tool caches
dist/
build/
.turbo/
coverage/
*.log

# Expo / React Native
.expo/
apps/mobile/.expo/

# Native projects are GENERATED by `expo prebuild` / `expo run:ios`, not authored.
# This is a managed (continuous native generation) project - the native dirs are
# rebuilt from app.json and the config plugins, so committing them means the next
# prebuild silently overwrites work nobody knew was tracked.
ios/
android/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Prisma generated client
packages/core/generated/
