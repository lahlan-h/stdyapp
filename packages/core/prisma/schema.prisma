generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // pooled connection (via Supabase's PgBouncer) — used for normal app queries
  url       = env("DATABASE_URL")
  // direct connection — required for migrations, bypasses the pooler
  directUrl = env("DIRECT_URL")
  // local throwaway database — see the postgres-shadow service in
  // docker-compose.yml. Used ONLY by `prisma migrate dev`, which needs
  // CREATE/DROP DATABASE rights that the Supabase pooler cannot grant.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String    @unique
  passwordHash String

  // The account-level real name. Nullable in the database so this migration
  // needed no backfill, but REQUIRED at signup — see registerSchema in
  // apps/api/src/validation/auth.validation.js.
  firstName    String?
  lastName     String?

  avatarUrl    String?
  bio          String?
  lastActiveAt DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions      Session[]
  ownedGroups   StudyGroup[]       @relation("GroupOwner")
  memberships   GroupMembership[]
  routines      StudyRoutine[]
  refreshTokens RefreshToken[]
  posts         Post[]
  likes         Like[]
  comments      Comment[]

  // Both sides of the follow graph. The relation names are written from the
  // ROW's point of view, so they read as the inverse of the field they land on:
  // the rows where this user is the follower ARE this user's following list.
  following     Follow[]           @relation("Following")
  followers     Follow[]           @relation("Followers")

  // Gamification and account state. `streak` and `subscription` are SINGULAR
  // and nullable because both are at-most-one per user - see the @unique on
  // their userId columns and the note above each model.
  goals         Goal[]
  streak        Streak?
  subscription  Subscription?
  notifications Notification[]

  @@map("users")
}

/// One row per issued refresh token — effectively "one logged-in device".
///
/// NOT called Session: `Session` above already means a STUDY session, which is
/// the app's core domain object. Naming this one Session too would make every
/// conversation and every import ambiguous.
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  // Cascade, unlike sessions.userId which is RESTRICT: a study session is a
  // historical record worth protecting from an accidental user delete, a
  // refresh token is disposable and should die with its owner.
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // SHA-256 of the token, never the token itself: a database leak must not hand
  // out working sessions. Deliberately NOT bcrypt — these are 32 bytes of CSPRNG
  // output with no guessable structure, so there is nothing to slow down, and
  // bcrypt would add ~300ms to every refresh for no security gain.
  tokenHash  String    @unique

  // Set when this token is rotated away or explicitly revoked. A request that
  // presents an ALREADY-revoked token means the token leaked — the service
  // responds by revoking every token for that user. Storing them is what makes
  // that detection possible at all.
  revokedAt  DateTime?
  expiresAt  DateTime

  // Purely so a user can recognise their own devices in a future "active
  // sessions" screen. Never trusted for auth decisions — clients set it freely.
  userAgent  String?
  createdAt  DateTime  @default(now())

  // revokeAllForUser() and any "list my devices" query filter on userId; the
  // @unique on tokenHash already indexes the lookup path used on every refresh.
  @@index([userId])
  @@map("refresh_tokens")
}

model Session {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])

  // nullable: a session is solo unless it's tied to a group session.
  // SetNull (not Cascade) on delete: if the group is deleted, past sessions
  // should keep existing as historical records, just no longer tied to a group.
  groupId       String?
  group         StudyGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  // nullable: only generated for group sessions, meaningless for solo ones
  inviteCode    String?   @unique

  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  focusPoints   Int       @default(0)

  interruptions SessionInterruption[]
  posts         Post[]

  @@map("sessions")
}

model SessionInterruption {
  id          String   @id @default(uuid())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  startedAt   DateTime @default(now())
  durationSec Int
  penaltyApplied Boolean @default(false)

  @@map("session_interruptions")
}

model StudyGroup {
  id          String   @id @default(uuid())
  ownerId     String
  owner       User     @relation("GroupOwner", fields: [ownerId], references: [id])

  name        String
  description String?

  // private groups still show up in search — joining just requires joinCode
  isPrivate   Boolean  @default(false)
  joinCode    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships GroupMembership[]
  sessions    Session[]

  @@map("study_groups")
}

enum GroupRole {
  MEMBER
  ADMIN
}

model GroupMembership {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  groupId   String
  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // separate from StudyGroup.ownerId — the owner is always the owner
  // regardless of role; this just marks a second tier of trusted members
  role      GroupRole  @default(MEMBER)

  joinedAt  DateTime   @default(now())

  @@unique([userId, groupId])
  @@map("group_memberships")
}

model StudyRoutine {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])

  // set when this routine was cloned ("taken") from someone else's shared
  // routine. SetNull on delete: if the original is deleted, clones remain
  // valid standalone routines, just lose the "cloned from" trace.
  sourceRoutineId String?
  sourceRoutine   StudyRoutine?  @relation("RoutineClones", fields: [sourceRoutineId], references: [id], onDelete: SetNull)
  clones          StudyRoutine[] @relation("RoutineClones")

  title           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  todoItems       TodoItem[]
  posts           Post[]

  @@map("study_routines")
}

model TodoItem {
  id          String       @id @default(uuid())
  routineId   String
  routine     StudyRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  title       String
  dueDate     DateTime?
  isComplete  Boolean      @default(false)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("todo_items")
}

/// A photo + caption published about a finished study session — the first
/// piece of the social feed.
model Post {
  id        String       @id @default(uuid())

  // The author. Restrict on delete (Prisma's default, as on sessions.userId
  // and study_routines.userId): deleting a user should be BLOCKED by the
  // content they still own rather than silently shredding it.
  userId    String
  user      User         @relation(fields: [userId], references: [id])

  // Optional: a post may be a plain status update, or it may be tied to the
  // session it came out of.
  //
  // SetNull, exactly as sessions.groupId does for groups: deleting a session
  // should cost you the LINK, not the post. Cascade stood here only while the
  // column was NOT NULL, which left no third option — Restrict would have
  // permanently broken DELETE /api/sessions/:id for anyone who had posted.
  sessionId String?
  session   Session?      @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  // Same reasoning as sessionId.
  routineId String?
  routine   StudyRoutine? @relation(fields: [routineId], references: [id], onDelete: SetNull)

  caption   String
  photoUrl  String
  createdAt DateTime     @default(now())

  likes     Like[]
  comments  Comment[]

  // Covers the per-user feed — the caller's own posts, newest first. Composite
  // rather than an index on userId alone so Postgres can satisfy the ORDER BY
  // from the index instead of sorting the matched rows.
  @@index([userId, createdAt])

  // The composite above CANNOT serve the global feed: createdAt is its second
  // column, and with no equality predicate on the leading userId there is no
  // usable ordering, so Postgres falls back to a sequential scan plus a sort.
  // GET /api/posts/all orders every post by date, so it needs createdAt as a
  // leading column of its own.
  @@index([createdAt])
  @@map("posts")
}

/// One tap of the heart on a post — the second piece of the social feed.
///
/// Deliberately has NO createdAt, unlike every other model here. Nothing this
/// app does cares WHEN a like happened: a heart renders from a count and a
/// "did I like this", and the row's mere existence answers both. The cost is
/// real and is paid in findLikesByPost — see the comment there.
model Like {
  id     String @id @default(uuid())

  // Cascade, unlike posts.userId which is Restrict. The reasoning is
  // refresh_tokens.userId's, not posts.userId's: a post is authored content
  // worth blocking a user delete over; a like is one bit of metadata that
  // means nothing once the person who left it is gone.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Cascade for the same reason, and load-bearing: Restrict here would make
  // DELETE /api/posts/:id start failing with a foreign-key error for any post
  // anyone had ever liked — the same trap sessionId's comment describes.
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  // One like per person per post. This is the entire integrity model of the
  // entity: it makes liking safely retryable from a double-tapped heart, and
  // it is the index that answers "have I liked this" on every feed render.
  @@unique([userId, postId])

  // The unique above indexes (userId, postId) and therefore CANNOT serve a
  // lookup by postId alone — which the like count and the "liked by" list
  // both do. Same reasoning as the composite index on posts.
  @@index([postId])

  @@map("likes")
}

/// A message left by one user on a post — the third piece of the social feed.
///
/// The commenter's display name and picture are deliberately NOT stored here.
/// They live on User and are joined on read through the same
/// {id, username, avatarUrl} allowlist the rest of the feed uses — a copy on the
/// comment would go stale the moment someone changed their avatar.
model Comment {
  id        String   @id @default(uuid())

  // Restrict (Prisma's default), matching posts.userId rather than likes.userId:
  // a comment is authored content worth blocking a user delete over, not one bit
  // of disposable metadata. DELETE /api/comments/user/me is the escape hatch,
  // exactly as DELETE /api/posts/user/me is for posts.
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  // Cascade, and load-bearing for the same reason likes.postId is: Restrict here
  // would make DELETE /api/posts/:id start failing with a foreign-key error for
  // any post anyone had ever commented on.
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  body      String
  createdAt DateTime @default(now())

  // Unlike Like, a comment IS editable, so unlike Like it earns a second
  // timestamp: this is authored prose, and a typo left in public text is worth
  // fixing. PATCH /api/comments/:id is what this column exists for.
  updatedAt DateTime @updatedAt

  // The thread query — one post's comments in conversation order. Composite
  // rather than an index on postId alone so Postgres can satisfy the ORDER BY
  // from the index instead of sorting the matched rows.
  @@index([postId, createdAt])

  // The profile's "comments I've left" list. Same shape, and the same reasoning,
  // as the per-user index on posts.
  @@index([userId, createdAt])

  // Neither composite above can serve GET /api/comments/all: createdAt is the
  // second column of both, and with no equality predicate on the leading column
  // there is no usable ordering. See the note on posts' @@index([createdAt]).
  @@index([createdAt])

  @@map("comments")
}

/// One directed edge of the follow graph — the last piece of the social feed.
///
/// Directed, not mutual: A following B says nothing about B following A, so the
/// pair is ordered and the two columns are never interchangeable. Everything
/// here is that ordering — read left-to-right, a row says "follower follows
/// following".
///
/// Carries no createdAt, for Like's reason: a follow renders from a count and a
/// "do I follow this person", and the row's mere existence answers both.
model Follow {
  id          String @id @default(uuid())

  // The person doing the following. Cascade, like likes.userId and unlike
  // posts.userId: a follow is one bit of metadata that means nothing once the
  // person who left it is gone, not authored content worth blocking a delete over.
  followerId  String
  follower    User   @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)

  // The person being followed. Cascade for the same reason, and load-bearing:
  // Restrict here would make deleting a user fail with a foreign-key error for
  // anyone who had ever been followed — the trap likes.postId's comment describes.
  followingId String
  following   User   @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  // One edge per ordered pair. As with Like, this is the entire integrity model
  // of the entity: it makes following safely retryable from a double-tapped
  // button, and it is the index that answers "do I follow this person" on every
  // profile render.
  @@unique([followerId, followingId])

  // The unique above leads with followerId and therefore CANNOT serve a lookup
  // by followingId alone — which the follower count and the followers list both
  // do. Same reasoning as the standalone index on likes.postId.
  @@index([followingId])

  @@map("follows")
}

/// How often a goal resets. An enum rather than the ERD's bare `string`, for
/// GroupRole's reason: "daily" and "Daily" and "DAILY" are three different rows
/// to Postgres and one concept to a user, and nothing but a constraint stops a
/// client inventing a fourth.
///
/// The two values are also load-bearing beyond validation - goal.service.js
/// switches on them to compute a period start, so a third value added here
/// without a matching branch there is a runtime failure rather than a silent
/// no-op.
enum GoalPeriod {
  DAILY
  WEEKLY
}

/// A study target the user sets for themselves - "90 minutes a day".
///
/// AT MOST ONE PER PERIOD, which is what @@unique([userId, period]) enforces and
/// is the entire integrity model of the entity. Without it a user accumulates
/// duplicate DAILY rows and "what is my daily target" stops having an answer,
/// which is the only question this table exists to answer. It is also what lets
/// the API address a goal by its PERIOD rather than its id - see goal.routes.js.
///
/// Cascade on delete, following likes and follows rather than posts and
/// sessions: a goal is a SETTING, not authored content worth blocking a user
/// delete over.
model Goal {
  id            String     @id @default(uuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  period        GoalPeriod
  targetMinutes Int

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([userId, period])
  @@map("goals")
}

/// The consecutive-days counter behind the streak on a user's profile.
///
/// ONE ROW PER USER - note the @unique on userId, which makes this a 1:1 with
/// User rather than the 1:N the ERD's crow's foot shows. That is a deliberate
/// divergence and the ERD should be corrected to `||--o|` to match: the columns
/// here describe a CURRENT streak, not a historical one. A history table would
/// need startedOn and endedOn, and nothing in the app asks for it.
///
/// DERIVED STATE, NOT USER INPUT. Nothing in the API lets a client write these
/// columns; the only writer is recordStudyDay() in streak.service.js, which
/// endSession calls. A PATCH here would make the number a claim rather than a
/// record, and the leaderboard in the pitch deck depends on it being a record.
model Streak {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  currentCount   Int       @default(0)

  /// @db.Date, not a full timestamp, and that is the point: the streak rule is
  /// "did they study YESTERDAY", a question about calendar days rather than
  /// instants. Storing a timestamp would invite comparing them directly and
  /// getting "yesterday at 23:00 vs today at 01:00" wrong.
  ///
  /// Nullable: a user who has never finished a session has no last active day,
  /// and 1970-01-01 would be a lie that compares as a real date.
  ///
  /// TIMEZONE: this is UTC, because the server has no idea where the user is.
  /// See the note above recordStudyDay in streak.service.js - for a Sydney user
  /// the day boundary lands at 10am local, and the real fix is a timezone
  /// column on User rather than anything in this file.
  lastActiveDate DateTime? @db.Date

  updatedAt      DateTime  @updatedAt

  @@map("streaks")
}

/// Where a subscription is in its lifecycle.
///
/// An enum for GoalPeriod's reason. CANCELLED and EXPIRED are deliberately
/// distinct: a cancelled subscription keeps its access until renewsAt passes,
/// so the two answer different questions and collapsing them would either cut
/// someone off early or leave them premium forever.
enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

/// The premium tier, from the pitch deck's stretch goals.
///
/// AT MOST ONE PER USER (@unique on userId), matching the ERD's `||--o|`. The
/// absence of a row IS the free tier - there is no FREE status, because a
/// status column that every user needs a row for is just a column on User.
///
/// ⚠ EVERY FIELD BELOW IS SERVER-WRITTEN. No request body reaches this table:
/// subscription.validation.js parses both write routes as an EMPTY strictObject,
/// so a client that tries to send `{"status":"ACTIVE"}` gets a 400 rather than a
/// free upgrade. This is the one table in the schema where that property is a
/// security boundary rather than tidiness, and it must survive any future edit.
///
/// There is no payment provider behind this yet. paymentReference holds a
/// locally generated stub id so the column has the shape it will need when a
/// real provider is wired in - see subscription.service.js.
model Subscription {
  id               String             @id @default(uuid())
  userId           String             @unique
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  status           SubscriptionStatus @default(ACTIVE)

  /// Nullable because a real provider assigns this asynchronously, and a stub
  /// should not pretend otherwise.
  paymentReference String?

  /// When the current period ends. Also the access deadline for a CANCELLED
  /// subscription, which is why cancelling does not clear it.
  renewsAt         DateTime?

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@map("subscriptions")
}

/// What happened, for a notification. An enum for GoalPeriod's reason, and one
/// with a second job: the client renders a different icon and deep link per
/// type, so this is an API contract rather than a label.
///
/// FOLLOW, POST_LIKE and POST_COMMENT have no emitter yet - the services that
/// would raise them live in the follow, like and comment routers, which this
/// change deliberately does not touch. They are declared here so that wiring
/// them up later is a one-line call rather than a migration.
enum NotificationType {
  FOLLOW
  POST_LIKE
  POST_COMMENT
  GROUP_JOIN
  STREAK_MILESTONE
  GOAL_REACHED
  SYSTEM
}

/// One item in a user's notification list.
///
/// SYSTEM-EMITTED, like Streak and unlike Goal: no route creates one. The only
/// writer is emitNotification() in notification.service.js. A client can mark
/// them read and delete them, which is the whole of its write surface.
///
/// The message is DENORMALISED - stored as rendered text rather than assembled
/// on read from the actor and target. That is the opposite call to Comment,
/// which deliberately joins the author's username so a rename is picked up, and
/// it is the right one here: a notification is a record of a moment ("Sam liked
/// your post"), and rewriting history when Sam changes their username would be
/// wrong rather than fresh. It also means this table needs no fanout
/// invalidation, because it embeds no row any counter tracks.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationType
  message   String
  isRead    Boolean          @default(false)

  /// Not in the ERD, and added anyway: a notification list is meaningless in
  /// any order but newest-first, and without a column to sort on Postgres is
  /// free to return them in whatever order it likes. The ERD should gain it.
  createdAt DateTime         @default(now())

  /// The list query - one user's notifications, newest first. Composite rather
  /// than an index on userId alone so Postgres satisfies the ORDER BY from the
  /// index instead of sorting the matched rows. Same reasoning as posts.
  @@index([userId, createdAt])

  /// The unread badge, which is the single most frequently hit read in this
  /// router - a client polls it on every app foreground. Counting from
  /// (userId, createdAt) would mean reading every row this user has ever
  /// received to discard the read ones.
  @@index([userId, isRead])

  @@map("notifications")
}

// TODO: remaining entities from the ERD - discover, analytics, moderation
// (BLOCKS, REPORTS, POST_BOOKMARKS) and stretch-goal entities (wearable data,
// Discord sync).
