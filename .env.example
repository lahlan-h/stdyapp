# stdyapp environment
#
# Copy to .env at the REPO ROOT - there is one shared file for the whole
# monorepo. apps/api/src/config/env.js, packages/core/prisma.config.js and
# apps/mobile/metro.config.js all read this same file.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real credentials.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# "development" unlocks two things and must never be set anywhere public:
# POST /api/auth/dev-token, which mints access tokens with NO credentials, and
# the CORS fallback that allows any browser origin.
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# ---------------------------------------------------------------------------

# Pooled connection, through PgBouncer - used for normal app queries.
DATABASE_URL=postgresql://postgres:password@localhost:5432/stdyapp?pgbouncer=true

# Direct connection, bypassing the pooler. Migrations REQUIRE this: PgBouncer
# cannot run the DDL and advisory locks Prisma Migrate needs.
DIRECT_URL=postgresql://postgres:password@localhost:5432/stdyapp

# Scratch database Prisma Migrate uses to verify migrations. Provided by the
# postgres-shadow service in docker-compose.yml.
SHADOW_DATABASE_URL=postgresql://postgres:shadow@localhost:5433/shadow

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------

# HS256 signing secret, minimum 32 characters - the API refuses to boot below
# that, because a short secret is brute-forceable offline from a single token.
# Generate one with:  openssl rand -base64 32
JWT_SECRET=replace-me-with-at-least-32-random-characters

# Google sign-in (POST /api/auth/google). Every OAuth client ID the app signs in
# from - web, iOS and Android - comma-separated, no spaces needed. A Google ID
# token is accepted only if it was issued to one of these, so list exactly your
# own. Optional: unset, the route answers 503 and the rest of the API is fine.
# The same three IDs go in the EXPO_PUBLIC_GOOGLE_* values under Mobile below.
#   GOOGLE_CLIENT_IDS=123-web.apps.googleusercontent.com,123-ios.apps.googleusercontent.com,123-android.apps.googleusercontent.com
GOOGLE_CLIENT_IDS=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Comma-separated browser origins allowed to call the API. Requests with no
# Origin header - the mobile app, curl, health probes - are always allowed;
# CORS only ever constrains browsers.
#
# Unset in development means "any origin". Unset anywhere else means NO browser
# origin is allowed, which fails closed.
CORS_ORIGINS=http://localhost:8081

# ---------------------------------------------------------------------------
# Redis and RabbitMQ  (docker compose up -d)
# ---------------------------------------------------------------------------

REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://stdyapp:stdyapp@localhost:5672

# Consumed by docker-compose.yml only. Change these together with the URLs above.
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_USER=stdyapp
RABBITMQ_PASSWORD=stdyapp
SHADOW_PG_PORT=5433

# ---------------------------------------------------------------------------
# Cloudflare R2 (image uploads)
# ---------------------------------------------------------------------------

R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=stdyapp
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://<your-public-bucket-domain>

# ---------------------------------------------------------------------------
# Mobile
# ---------------------------------------------------------------------------


# Where the mobile app reaches the API above. Must keep the EXPO_PUBLIC_ prefix:
# anything else is not inlined into the bundle and reads as undefined on device.
#
# The right host depends on where the app is running, and getting it wrong looks
# like a network error rather than a config one:
#   iOS simulator     http://localhost:4000
#   Android emulator  http://10.0.2.2:4000   (localhost is the emulator itself)
#   physical device   http://<your-LAN-IP>:4000, and open port 4000 on the firewall
#
# Leave it unset to take the per-platform default for the first two. A device on
# the LAN has no default that can be guessed - set it explicitly.
#
# Easiest option for a real phone is the ngrok tunnel - see ngrok.example.yml and
# `npm run tunnel`. Then this is the tunnel's URL, with NO trailing slash:
#   EXPO_PUBLIC_API_URL=https://<your-domain>.ngrok-free.app
EXPO_PUBLIC_API_URL=

# Shared secret the tunnel checks before forwarding anything, matching the
# x-tunnel-key expression in ngrok.yml. Only needed when tunnelling - leave it
# empty for localhost or LAN, and the header is simply not sent.
#
# NOT a real credential: EXPO_PUBLIC_ values are inlined into the app bundle and
# readable by anyone who unpacks it. It keeps drive-by scanners off a tunnel that
# would otherwise expose POST /api/auth/dev-token, which mints tokens with no
# credentials whenever NODE_ENV=development.
EXPO_PUBLIC_TUNNEL_KEY=

# Google sign-in's OAuth client IDs, one per platform, from Google Cloud Console
# -> APIs & Services -> Credentials. Client IDs are public by design (they ship
# in every Google-enabled app); there is no client SECRET anywhere in this flow.
# A platform whose ID is empty shows "Google sign-in isn't set up yet" on the
# button instead of opening Google. Phones need a development build - Google
# sign-in does not work inside Expo Go.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# ---------------------------------------------------------------------------
# Stripe (subscriptions)
# ---------------------------------------------------------------------------

# All three are REQUIRED - the API refuses to boot without them, see
# apps/api/src/config/stripe.js.

# The SECRET key (sk_test_... in test mode), not the publishable pk_ one.
STRIPE_SECRET_KEY=sk_

# ⚠ NOT the dashboard's signing secret while developing locally. `stripe listen`
# prints its own whsec_ on every run and that is the one that verifies CLI-
# forwarded events.
STRIPE_WEBHOOK_SECRET=

# A recurring price, not a product. price_..., not prod_...
STRIPE_PRICE_ID=price_

STRIPE_API_VERSION=2026-08-26.

# Where Checkout returns afterwards. Optional - these defaults point at Metro,
# and are only meaningful once mobile is wired to this API.
# STRIPE_SUCCESS_URL=http://localhost:8081/subscription/success
# STRIPE_CANCEL_URL=http://localhost:8081/subscription/cancelled