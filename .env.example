# stdyapp environment
#
# Copy to .env at the REPO ROOT - there is one shared file for the whole
# monorepo. apps/api/src/config/env.js, packages/core/prisma.config.js and
# apps/mobile/metro.config.js all read this same file.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real credentials.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# "development" unlocks two things and must never be set anywhere public:
# POST /api/auth/dev-token, which mints access tokens with NO credentials, and
# the CORS fallback that allows any browser origin.
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# ---------------------------------------------------------------------------

# Pooled connection, through PgBouncer - used for normal app queries.
DATABASE_URL=postgresql://postgres:password@localhost:5432/stdyapp?pgbouncer=true

# Direct connection, bypassing the pooler. Migrations REQUIRE this: PgBouncer
# cannot run the DDL and advisory locks Prisma Migrate needs.
DIRECT_URL=postgresql://postgres:password@localhost:5432/stdyapp

# Scratch database Prisma Migrate uses to verify migrations. Provided by the
# postgres-shadow service in docker-compose.yml.
SHADOW_DATABASE_URL=postgresql://postgres:shadow@localhost:5433/shadow

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------

# HS256 signing secret, minimum 32 characters - the API refuses to boot below
# that, because a short secret is brute-forceable offline from a single token.
# Generate one with:  openssl rand -base64 32
JWT_SECRET=replace-me-with-at-least-32-random-characters

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Comma-separated browser origins allowed to call the API. Requests with no
# Origin header - the mobile app, curl, health probes - are always allowed;
# CORS only ever constrains browsers.
#
# Unset in development means "any origin". Unset anywhere else means NO browser
# origin is allowed, which fails closed.
CORS_ORIGINS=http://localhost:8081

# ---------------------------------------------------------------------------
# Redis and RabbitMQ  (docker compose up -d)
# ---------------------------------------------------------------------------

REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://stdyapp:stdyapp@localhost:5672

# Consumed by docker-compose.yml only. Change these together with the URLs above.
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_USER=stdyapp
RABBITMQ_PASSWORD=stdyapp
SHADOW_PG_PORT=5433

# ---------------------------------------------------------------------------
# Cloudflare R2 (image uploads)
# ---------------------------------------------------------------------------

R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=stdyapp
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://<your-public-bucket-domain>

# ---------------------------------------------------------------------------
# Mobile
# ---------------------------------------------------------------------------

# No trailing slash - copying from the dashboard's address bar adds one, and it
# makes the websocket 404 with a reconnect loop.
# TEMPORARY. The mobile app still reads from packages/convex-stub while it is
# migrated onto the API above - see that package's README. Printed by
# `npx convex dev` in packages/convex-stub.
EXPO_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud
