{
  "name": "stdyapp",
  "version": "0.0.0",
  "description": "Set goals, find friends, see results.",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "npm run dev -w @stdyapp/api",
    "dev:mobile": "npm run dev -w @stdyapp/mobile",
    "tunnel": "ngrok start --config ngrok.yml stdyapp-api-ngrok",
    "build": "turbo run build",
    "db:generate": "npm run db:generate -w @stdyapp/core",
    "db:migrate": "npm run db:migrate -w @stdyapp/core",
    "db:deploy": "npm run db:deploy -w @stdyapp/core",
    "db:studio": "npm run db:studio -w @stdyapp/core"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lahlan-h/stdyapp.git"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "license": "Apache-2.0",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=26.3.0",
    "npm": ">=11.16.0"
  },
  "devDependencies": {
    "turbo": "^2.10.2"
  }
}
